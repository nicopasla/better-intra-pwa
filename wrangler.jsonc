{
  "name": "better-intra-pwa",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "mobile.betterintra.com",
      "zone_name": "betterintra.com",
      "custom_domain": true,
      "enabled": true,
    },
  ],
}
